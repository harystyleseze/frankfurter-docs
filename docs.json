  "readiness": {
    "topK": 5,
    "goldenQuestions": [
      { "question": "How do I convert US dollars to Nigerian naira?", "expect": ["/quickstart"] },
      { "question": "Does Frankfurter need an API key?", "expect": ["/", "/api/introduction"] },
      { "question": "How do I get exchange rates for a date range?", "expect": ["/guides/historical-rates"] },
      { "question": "How do I download rates as CSV?", "expect": ["/guides/historical-rates", "/api/introduction"] },
      { "question": "What does the 422 invalid currency error mean?", "expect": ["/guides/historical-rates", "/api/introduction"] },
      { "question": "How do I get the official Central Bank of Nigeria rate?", "expect": ["/guides/historical-rates"] },
      { "question": "What is the base URL of the Frankfurter API?", "expect": ["/api/introduction"] },
      { "question": "Should I cache responses, and how often does Frankfurter publish new rates?", "expect": ["/api/introduction", "/quickstart"] }
